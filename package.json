{
  "name": "simplaexity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-gated execution controller for AI-assisted software work.",
  "packageManager": "pnpm@12.10.1",
  "engines": { "node": ">=24.21.0 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
